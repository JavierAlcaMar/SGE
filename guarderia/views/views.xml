<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST -->
    <record id="view_guarderia_servicio_list" model="ir.ui.view">
        <field name="name">guarderia.servicio.list</field>
        <field name="model">guarderia.servicio</field>
        <field name="arch" type="xml">
            <list string="Servicios de Guardería">
                <field name="name"/>      <!-- hr.employee (delegado) -->
                <field name="start"/>     <!-- calendar.event (delegado) -->
                <field name="stop"/>      <!-- calendar.event (delegado) -->
                <field name="age_range"/> <!-- propio -->
            </list>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_guarderia_servicio_form" model="ir.ui.view">
        <field name="name">guarderia.servicio.form</field>
        <field name="model">guarderia.servicio</field>
        <field name="arch" type="xml">
            <form string="Servicio de Guardería">
                <sheet>

                    <group>
                        <group string="Servicio">
                            <field name="age_range"/>
                            <field name="description"/>
                        </group>

                        <group string="Monitor (Empleado)">
                            <field name="employee_id"/>
                            <field name="name"/>
                            <field name="work_email"/>
                        </group>
                    </group>

                    <group string="Horario (Evento)">
                        <field name="event_id"/>
                        <field name="start"/>
                        <field name="stop"/>
                        <field name="partner_ids"
                               widget="many2many_tags"
                               string="Padres (asistentes)"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_guarderia_servicio" model="ir.actions.act_window">
        <field name="name">Servicios Guardería</field>
        <field name="res_model">guarderia.servicio</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- MENÚ -->
    <menuitem id="menu_guarderia_root"
              name="Guardería"
              sequence="10"/>

    <menuitem id="menu_guarderia_servicio"
              name="Servicios"
              parent="menu_guarderia_root"
              action="action_guarderia_servicio"
              sequence="10"/>

</odoo>

